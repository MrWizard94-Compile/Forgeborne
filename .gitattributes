# Unity's serializer emits a space after empty YAML values. Preserve its native
# representation; continue checking other whitespace errors in these formats.
*.unity whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol

# Embedded authored geometry is an exact save identity. Keep the generator's
# UTF-8/LF bytes stable across Windows and clean-checkout builds.
src/Forgeborne.Core/Content/*.json text eol=lf
